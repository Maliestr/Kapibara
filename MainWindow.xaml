<Window x:Class="Graphic_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphic_Editor"
        mc:Ignorable="d"
        x:Name="Main"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Icon="/Icons/L.png"
        Title="Kapibara"
        MinHeight="800"
        MinWidth="1200"
        Height="800"
        Width="1200"
        Background="#FF252525"
        FontFamily="Gotham Pro">
    <!--Widht и Height нужны для правильной визуализации окна-->
    
    <Window.Resources>
        <!-- Общий стиль для кнопок заголовка (минимизация/максимизация) с подсветкой при наведении -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красная подсветка для кнопки закрытия -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F3F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#272727"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TogglePanelsButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F3F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#272727"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid Height="{Binding ActualHeight, ElementName=Main}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#424242"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и меню -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                    <Image Source="/Icons/L.png" Width="25.82" Height="25.82" Margin="15,11,15,3"/>

                    <Menu Background="Transparent" FontSize="12" Foreground="White" 
                          WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom" Height="34">
                        <MenuItem Header="Файл" Margin="0,2,18,0" Height="32">
                            <MenuItem Header="Новый" Click="NewFile_Click"/>
                            <MenuItem Header="Открыть..." Click="OpenFile_Click"/>
                            <MenuItem Header="Сохранить" Click="SaveFile_Click"/>
                            <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click"/>
                            <!-- Экспорт в картинку -->
                            <MenuItem Header="Экспорт в изображение..." Click="ExportToImage_Click"/>
                            <Separator/>
                            <MenuItem Header="Выход" Click="Exit_Click"/>
                        </MenuItem>

                        <MenuItem Header="Вид" Margin="0,2,18,0" Height="32" Width="36">
                            <MenuItem Header="Увеличить" Click="ZoomIn_Click"/>
                            <MenuItem Header="Уменьшить" Click="ZoomOut_Click"/>
                            <MenuItem Header="Сбросить масштаб" Click="ResetZoom_Click"/>
                            <Separator/>
                            <!-- Новый пункт для переключения сетки -->
                            <MenuItem x:Name="GridToggleMenuItem" 
                                      Header="Сетка" 
                                      Click="GridToggleMenuItem_Click"
                                      IsCheckable="True"/>
                            <MenuItem x:Name="SnapToGridMenuItem" 
                                      Header="Привязка к сетке" 
                                      Click="SnapToGridMenuItem_Click"
                                      IsCheckable="True"/>
                        </MenuItem>

                        <MenuItem Header="Правка" Margin="0,2,18,0" Height="32">
                            <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                            <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                            <Separator/>
                            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                            <MenuItem Header="Вставить" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                            <Separator/>
                            <MenuItem Header="Выделить все" InputGestureText="Ctrl+A"/>
                            <MenuItem Header="Удалить" InputGestureText="Delete"/>
                        </MenuItem>

                        <MenuItem Header="Справка" Height="32" Margin="0,2,0,0">
                            <MenuItem Header="Справка" InputGestureText="F1" Click="Help_Click"/>
                            <MenuItem Header="О программе" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" Width="144">
                    <Button x:Name="MinimizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MinimizeBtn_Click" Width="46" Height="34"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0.6,0,0" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Line 3.png" Width="12" Height="12" Margin="0,2,0,0"/>
                    </Button>

                    <Button x:Name="MaximizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MaximizeBtn_Click" Width="46" Height="34"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Group 2.png" Width="12" Height="12" Margin="0,2,0,0"/>
                    </Button>

                    <Button x:Name="CloseBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="Exit_Click" Width="46" Height="34"
                            Style="{StaticResource CloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom" Margin="0,0,6,0">
                        <Image Source="/Icons/Group 1.png" Width="12" Height="12" Margin="0,2,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Width="{Binding ActualWidth, ElementName=Main}"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Основной Canvas для всех элементов -->
            <Canvas x:Name="MainCanvas" Background="#252525" 
                    Grid.Row="1" Grid.ColumnSpan="3" Loaded="MainCanvas_Loaded"/>

            <Border x:Name="Titl" Grid.Column="0"
                    Width="270" Height="60"
                    Background="#343434"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0">
                
                <Grid Width="{Binding ActualWidth, ElementName=Titl}" 
                      Height="{Binding ActualHeight, ElementName=Titl}">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="Untaitled" Background="Transparent"
                             Height="18" Grid.Column="1" Margin="0,0,0,1"
                             Foreground="White" VerticalAlignment="Center"
                             AcceptsReturn="False" MaxLength="50"
                             BorderThickness="0" FontSize="16"/>

                    <ToggleButton x:Name="TogglePanelsButton" Style="{StaticResource TogglePanelsButtonStyle}"
                            Grid.Column="2" HorizontalAlignment="Right" 
                            VerticalAlignment="Center" Margin="0,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Width="34" Height="26" Cursor="Hand"
                            Click="TogglePanelsButton_Click">
                        <Image Source="/Icons/КнСк.png" 
                               Width="24" Height="12"/>
                    </ToggleButton>
                </Grid>
            </Border>
            
            <!-- Нотация -->
            <Border x:Name="NotationCard"
                    Grid.Column="0"
                    Width="270"
                    Height="352"
                    Background="#343434"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,100,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Нотация" 
                                Grid.Row="0"                            
                                FontSize="14"
                               Grid.ColumnSpan="2"
                                FontWeight="SemiBold"
                                Foreground="White"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                    </TextBlock>

                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2"
                                  VerticalScrollBarVisibility="Hidden" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <!--Поменять стиль полосы прокрутки-->
                        <Canvas x:Name="NotationCanvas" Height="428" 
                                Background="Transparent">

                            <Grid Width="{Binding ActualWidth, ElementName=NotationCanvas}"
                                  Height="{Binding ActualHeight, ElementName=NotationCanvas}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Ellipse x:Name="Circle"
                                         Width="70"
                                         Height="70"
                                         Fill="White"
                                         Stroke="White"
                                         StrokeThickness="3"
                                         Grid.Column="0"
                                         Cursor="Hand" HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"/>
                            
                                <Ellipse x:Name="SimpleRing"
                                         Width="70"
                                         Height="70"
                                         Stroke="White"
                                         StrokeThickness="3"
                                         Fill="Transparent"
                                         Grid.Column="1" HorizontalAlignment="Center" 
                                         VerticalAlignment="Center" Cursor="Hand"/>
                            
                                <!-- Кольцо -->
                                <Ellipse x:Name="Ellipse"
                                        Stroke="White"
                                        StrokeThickness="3"
                                        Fill="Transparent" Grid.Column="1" Grid.Row="1"
                                         HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Cursor="Hand" Height="42" Width="90"/>

                                <Border x:Name="UmlInitialNode" 
                                        Width="70" 
                                        Height="70"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="3"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        CornerRadius="35" Grid.Column="0" Grid.Row="1"
                                        Cursor="Hand">

                                    <Ellipse Width="56"
                                        Height="56"
                                        Fill="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                
                                <Border x:Name="Square"
                                        Width="60"
                                        Height="60"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="3" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" 
                                        Grid.Column="0" Grid.Row="2"
                                        Cursor="Hand"/>
                                
                                <Border x:Name="Rectangle"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        BorderThickness="3" Grid.Column="1" Grid.Row="2"
                                        Cursor="Hand" RenderTransformOrigin="0.506,0.529" Height="38" Width="80"/>

                                <!-- Прямоугольник -->
                                <Border x:Name="SuperEllipse"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="3"
                                        CornerRadius="25" Grid.Column="0" Grid.Row="3" 
                                        Cursor="Hand" RenderTransformOrigin="0.506,0.529" Height="38" Width="80" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <Border x:Name="ResizableSquare"
                                        Width="50"
                                        Height="50"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="3" HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        CornerRadius="0" Grid.Column="1" Grid.Row="3"
                                        Cursor="Hand" RenderTransformOrigin="0.557,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="45"/>
                                            <TranslateTransform X="0" Y="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="stick"
                                        Background="White"
                                        BorderBrush="White"
                                        BorderThickness="3" HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Grid.ColumnSpan="2" Grid.Row="4"
                                        Cursor="Hand" Height="6" Width="150"/>

                            </Grid>
                        </Canvas>
                    </ScrollViewer>
                </Grid>

            </Border>
            <!-- Прямоугольная панель снизу -->
            <Border x:Name="ControlPanel"
                    CornerRadius="10" Grid.Column="1"
                    Background="#FF343434" Width="290" 
                    Height="52" Margin="80" BorderBrush="#CCCCCC"
                    BorderThickness="1" Grid.Row="2" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Cursor="">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Width="290" Height="52" HorizontalAlignment="Center">
                    <Grid Width="{Binding ActualWidth, ElementName=ControlPanel}"
                          Height="{Binding ActualHeight, ElementName=ControlPanel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <!-- Ручной инструмент -->
                        <Button x:Name="cursor" Style="{StaticResource ControlButtonStyle}"
                                Width="34" 
                                Height="34"
                                Cursor="Hand"
                                Grid.Column="1"
                                Background="#FF343434"
                                BorderBrush="Transparent"
                                FocusVisualStyle="{x:Null}" 
                                HorizontalAlignment="Center">
                            <Image Source="/Icons/Cursor.png"
                                   Width="30" 
                                   Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Перо -->
                        <Button x:Name="pencil" Style="{StaticResource ControlButtonStyle}"
                                Width="34" 
                                Height="34"
                                Cursor="Hand"
                                Grid.Column="2"
                                Background="#FF343434"
                                BorderBrush="Transparent"
                                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Pencil.png"
                                   Width="30" 
                                   Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратик -->
                        <Button x:Name="rectangle" Style="{StaticResource ControlButtonStyle}"
                                Width="34"
                                Height="34"
                                Cursor="Hand"
                                Grid.Column="3"
                                Background="#FF343434"
                                BorderBrush="Transparent"
                                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Rectangle.png"
                                   Width="30" 
                                   Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Текст -->
                        <Button x:Name="text" Style="{StaticResource ControlButtonStyle}"
                                Width="34" 
                                Height="34"
                                Cursor="Hand"
                                Grid.Column="4"
                                Background="#FF343434"
                                BorderBrush="Transparent"
                                FocusVisualStyle="{x:Null}"
                                Click="TextButton_Click">
                            <Image Source="/Icons/Writing.png"
                                Width="30" 
                                Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Комментарий -->
                        <Button x:Name="comment" Style="{StaticResource ControlButtonStyle}"
                            Width="34" 
                            Height="34"
                            Cursor="Hand"
                            Grid.Column="5"
                            Background="#FF343434"
                            BorderBrush="Transparent"
                            FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Com.png"
                                Width="30" 
                                Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратики -->
                        <Button x:Name="dash" Style="{StaticResource ControlButtonStyle}"
                            Width="34" 
                            Height="34"
                            Cursor="Hand"
                            Grid.Column="6"
                            Background="#FF343434"
                            BorderBrush="Transparent"
                            FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/dashboard.png"
                                Width="30" 
                                Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PropertiesPanel" 
                        Grid.Column="2"
                        Width="270" 
                        VerticalAlignment="Top"
                        Margin="0,20,0,0">
                <!-- Панель с размерами -->
                <Border x:Name="DimensionsPanel" CornerRadius="10"
                                Background="#FF343434" 
                                Width="270" 
                                Height="84"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                                Margin="0,0,0,0" HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="200" Height="61">

                        <TextBlock Text="Размеры" 
                                Foreground="White" 
                                FontSize="14"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <!-- Ширина -->
                            <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock Text="W" 
                                        Foreground="White" 
                                        FontSize="12"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Width="20"
                                        TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                    Width="60" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center"
                                    Margin="5,0,0,0">
                                    <TextBox x:Name="WidthTextBox"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="11"
                                            VerticalContentAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Text=""/>
                                </Border>
                            </StackPanel>

                            <!-- Высота -->
                            <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">
                                <TextBlock Text="H" 
                                        Foreground="White" 
                                        FontSize="12"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Width="20"
                                        TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                    Width="60" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center"
                                    Margin="5,0,0,0">
                                    <TextBox x:Name="HeightTextBox"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="11"
                                            VerticalContentAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Text=""/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Панель с заливкой -->
                <Border x:Name="FillPanel" CornerRadius="10" 
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                Background="#FF343434" 
                Width="270" 
                Height="84"
                Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Заливка" 
                            Foreground="White" 
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Превью цвета -->
                            <Border x:Name="FillColorPreview"
                        CornerRadius="5"
                        Width="40" 
                        Height="22"
                        Background="#FFC44141"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        BorderThickness="1"
                        BorderBrush="#FF666666"/>

                            <!-- Выпадающий список цветов -->
                            <ComboBox x:Name="FillColorComboBox"
                          Width="92" 
                          Height="22"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Background="#D9D9D9"
                          BorderThickness="0"
                          FontSize="11"
                          SelectedIndex="0"
                          SelectionChanged="FillColorComboBox_SelectionChanged">

                            <ComboBoxItem Tag="C44141">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Красный" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                            <ComboBoxItem Tag="4166C4">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Синий" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                            <ComboBoxItem Tag="41C441">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Зеленый" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                            <ComboBoxItem Tag="C4C441">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Желтый" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                            <ComboBoxItem Tag="000000">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Черный" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Панель с обводкой -->
                <Border x:Name="StrokePanel" CornerRadius="10"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                Background="#FF343434" 
                Width="270" 
                Height="84"
                Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Обводка" 
                            Foreground="White" 
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10"/>

                        <!-- Поле с цветом обводки -->
                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <StackPanel x:Name="StrokeWidthPanel" Orientation="Vertical" Margin="0,5,0,0" Visibility="Collapsed">
                                <TextBlock Text="Толщина обводки:" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox x:Name="StrokeWidthComboBox" Height="25" FontSize="11" SelectionChanged="StrokeWidthComboBox_SelectionChanged">
                                    <ComboBoxItem Content="1 px" Tag="1"/>
                                    <ComboBoxItem Content="2 px" Tag="2"/>
                                    <ComboBoxItem Content="3 px" Tag="3"/>
                                    <ComboBoxItem Content="5 px" Tag="5"/>
                                    <ComboBoxItem Content="8 px" Tag="8"/>
                                    <ComboBoxItem Content="10 px" Tag="10"/>
                                </ComboBox>
                            </StackPanel>
                            <!-- Превью цвета обводки -->
                            <Border x:Name="StrokeColorPreview"
                        CornerRadius="5"
                        Width="40" 
                        Height="22"
                        Background="#FF000000"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        BorderThickness="1"
                        BorderBrush="#FF666666" RenderTransformOrigin="0.512,0.527"/>

                            <!-- Выпадающий список цветов обводки -->
                            <ComboBox x:Name="StrokeColorComboBox"
                          Width="92" 
                          Height="22"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Background="#D9D9D9"
                          BorderThickness="0"
                          FontSize="11"
                          SelectedIndex="0"
                          SelectionChanged="StrokeColorComboBox_SelectionChanged">

                                <ComboBoxItem Tag="000000">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="Черный" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem Tag="FFFFFF">
                                    <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Белый" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem Tag="C44141">
                                    <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Красный" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem Tag="4166C4">
                                    <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Синий" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>

                                <ComboBoxItem Tag="41C441">
                                    <StackPanel Orientation="Horizontal" Margin="2">

                                        <TextBlock Text="Зеленый" 
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                        </StackPanel>
                        <!-- Превью цвета обводки -->
                        <Border x:Name="StrokeColorPreview"
                    CornerRadius="5"
                    Width="40" 
                    Height="22"
                    Background="#FF000000"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    BorderThickness="1"
                    BorderBrush="#FF666666" RenderTransformOrigin="0.512,0.527"/>

                        <!-- Выпадающий список цветов обводки -->
                        <ComboBox x:Name="StrokeColorComboBox"
                      Width="92" 
                      Height="22"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Background="#D9D9D9"
                      BorderThickness="0"
                      FontSize="11"
                      SelectedIndex="0"
                      SelectionChanged="StrokeColorComboBox_SelectionChanged">

                            <ComboBoxItem Tag="000000">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="Черный" 
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>

                            <ComboBoxItem Tag="FFFFFF">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                    <TextBlock Text="Белый" 
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>

                            <ComboBoxItem Tag="C44141">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                    <TextBlock Text="Красный" 
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>

                            <ComboBoxItem Tag="4166C4">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                    <TextBlock Text="Синий" 
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>

                            <ComboBoxItem Tag="41C441">
                                <StackPanel Orientation="Horizontal" Margin="2">

                                    <TextBlock Text="Зеленый" 
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                    </StackPanel>
                </Border>

                <!-- Панель с текстом -->
                <Border x:Name="TextPanel" CornerRadius="10"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Background="#FF343434" 
            Width="270" 
            Height="120"
            Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="200">

                        <TextBlock Text="Текст" 
                       Foreground="White" 
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

                        <!-- Шрифт -->
                        <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10">

                            <Border CornerRadius="5"
                        Width="150" 
                        Height="22"
                        Background="#D9D9D9"
                        VerticalAlignment="Center">
                                <ComboBox x:Name="FontComboBox"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="11"
                              VerticalContentAlignment="Center"
                              Padding="5,0"
                              SelectionChanged="FontComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Gotham Pro" IsSelected="True"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Calibri"/>
                                    <ComboBoxItem Content="Verdana"/>
                                    <ComboBoxItem Content="Tahoma"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Стиль и размер -->
                        <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                            <!-- Стиль -->
                            <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                                <Border CornerRadius="5"
                            Width="60" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center">
                                    <ComboBox x:Name="FontStyleComboBox"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  Padding="5,0" 
                                  Margin="0,0,-8,0"
                                  SelectionChanged="FontStyleComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Regular" IsSelected="True"/>
                                        <ComboBoxItem Content="Bold"/>
                                        <ComboBoxItem Content="Italic"/>
                                        <ComboBoxItem Content="Bold Italic"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <!-- Размер -->
                            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" 
                            Width="53">

                                <Border CornerRadius="5"
                            Width="50" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center">
                                    <ComboBox x:Name="FontSizeComboBox"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  Padding="5,0"
                                  SelectionChanged="FontSizeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10" IsSelected="True"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="18"/>
                                        <ComboBoxItem Content="20"/>
                                        <ComboBoxItem Content="24"/>
                                        <ComboBoxItem Content="28"/>
                                        <ComboBoxItem Content="32"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>
</Window>