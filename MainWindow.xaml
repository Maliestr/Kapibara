<Window x:Class="Graphic_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphic_Editor"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        MinHeight="800"
        MinWidth="1200"
        Padding="6"
        Background="#FF252525"
        FontFamily="Gotham Pro">

    <Window.Resources>
        <!-- Общий стиль для кнопок заголовка (минимизация/максимизация) с подсветкой при наведении -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красная подсветка для кнопки закрытия -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#424242" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и меню -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                    <Image Source="/Icons/L.png" Width="25.82" Height="25.82" Margin="15,11,15,3"/>

                    <Menu Background="Transparent" FontSize="12" Foreground="#FFEEEEEE" 
                          WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,8,0,0">
                        <MenuItem Header="Файл" VerticalAlignment="Center" Margin="0,0,18,0">
                            <MenuItem Header="Новый" Click="NewFile_Click"/>
                            <MenuItem Header="Открыть..." Click="OpenFile_Click"/>
                            <MenuItem Header="Сохранить" Click="SaveFile_Click"/>
                            <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click"/>
                            <Separator/>
                            <MenuItem Header="Выход" Click="Exit_Click"/>
                        </MenuItem>

                        <MenuItem Header="Вид" Margin="0,0,18,0">
                            <MenuItem Header="Увеличить" Click="ZoomIn_Click"/>
                            <MenuItem Header="Уменьшить" Click="ZoomOut_Click"/>
                            <MenuItem Header="Сбросить масштаб" Click="ResetZoom_Click"/>
                        </MenuItem>

                        <MenuItem Header="Правка" Margin="0,0,18,0">
                            <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                            <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                            <Separator/>
                            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                            <MenuItem Header="Вставить" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                        </MenuItem>

                        <MenuItem Header="Справка">
                            <MenuItem Header="Справка" InputGestureText="F1" Click="Help_Click"/>
                            <MenuItem Header="О программе" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Заголовок окна -->

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" Width="144">
                    <Button x:Name="MinimizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MinimizeBtn_Click" Width="46" Height="32"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0.6,0,0" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Line 3.png" Width="12" Height="12"/>
                    </Button>

                    <Button x:Name="MaximizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MaximizeBtn_Click" Width="46" Height="32"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Group 2.png" Width="12" Height="12"/>
                    </Button>

                    <Button x:Name="CloseBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="CloseBtn_Click" Width="46" Height="32"
                            Style="{StaticResource CloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Group 1.png" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="#FF1E1E1E"/>

        <Border Grid.Row="1" Grid.ColumnSpan="2">
            <!--мои изменения тут -->
            <Grid>

                <!-- Основная рабочая область -->
                <Canvas x:Name="MainCanvas"
    Margin="10,0,10,20"/>

                <!-- Прямоугольная панель снизу -->
                <Border CornerRadius="11.72" 
        Background="#FF343434" 
        Width="293" 
        Height="52"
        Margin="458,694,453,38"
        Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="">
                    <StackPanel Orientation="Horizontal"
               VerticalAlignment="Center" Width="293" Height="52" HorizontalAlignment="Center">
                        <!-- Ручной инструмент -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="16,0,5,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}" HorizontalAlignment="Center">
                            <Image Source="/Icons/Vector.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Перо -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="9,0,11,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/pen.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратик -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="4,0,5,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Rectangle 20.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Текст -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="12,0,5,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}"
                Click="TextButton_Click">
                            <Image Source="/Icons/text.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Комментарий -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="8,0,5,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/message.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратики -->
                        <Button      
                Width="32" 
                Height="32"
                Cursor="Hand"
                Margin="9,0,0,0"
                Background="#FF343434"
                BorderBrush="Transparent"
                FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/dashboard.png"
                            Width="30" 
                            Height="30"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Cursor="Hand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="617*"/>
                    <RowDefinition Height="143*"/>
                </Grid.RowDefinitions>

                <!-- Прямоугольная панель справа 1 -->
                <Border CornerRadius="15" 
        Background="#FF343434" 
        Width="240" 
        Height="84"
        Margin="939,15,26,518" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Height="84">

                        <!-- Первый белый прямоугольник -->
                        <Border CornerRadius="3"
                Width="80" 
                Height="24"
                Background="#D9D9D9"
                Margin="10,0,5,0"
                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                                <!-- Текст слева -->
                                <Button      
                    Width="22" 
                    Height="22"
                    Cursor="Hand"
                    Margin="2,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/text-align-left.png"
                           Width="16" 
                           Height="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                                </Button>
                                <!-- Текст в центре -->
                                <Button      
                    Width="22" 
                    Height="22"
                    Cursor="Hand"
                    Margin="2,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/text-align-center.png"
                           Width="16" 
                           Height="16"
                           VerticalAlignment="Center"
