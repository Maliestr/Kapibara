<Window x:Class="Graphic_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphic_Editor"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        MinHeight="800"
        MinWidth="1200"
        Padding="6"
        Background="#FF252525"
        FontFamily="Gotham Pro">

    <Window.Resources>
        <!-- Общий стиль для кнопок заголовка (минимизация/максимизация) с подсветкой при наведении -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красная подсветка для кнопки закрытия -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#e81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#424242" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и меню -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Background="Transparent">
                    <Image Source="/Icons/L.png" Width="25.82" Height="25.82" Margin="15,11,15,3"/>

                    <Menu Background="Transparent" FontSize="12" Foreground="#FFEEEEEE" 
                          WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,8,0,0">
                        <MenuItem Header="Файл" VerticalAlignment="Center" Margin="0,0,18,0">
                            <MenuItem Header="Новый" Click="NewFile_Click"/>
                            <MenuItem Header="Открыть..." Click="OpenFile_Click"/>
                            <MenuItem Header="Сохранить" Click="SaveFile_Click"/>
                            <MenuItem Header="Сохранить как..." Click="SaveAsFile_Click"/>
                            <Separator/>
                            <MenuItem Header="Выход" Click="Exit_Click"/>
                        </MenuItem>

                        <MenuItem Header="Вид" Margin="0,0,18,0">
                            <MenuItem Header="Увеличить" Click="ZoomIn_Click"/>
                            <MenuItem Header="Уменьшить" Click="ZoomOut_Click"/>
                            <MenuItem Header="Сбросить масштаб" Click="ResetZoom_Click"/>
                        </MenuItem>

                        <MenuItem Header="Правка" Margin="0,0,18,0">
                            <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                            <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                            <Separator/>
                            <MenuItem Header="Вырезать" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                            <MenuItem Header="Копировать" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                            <MenuItem Header="Вставить" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                        </MenuItem>

                        <MenuItem Header="Справка">
                            <MenuItem Header="Справка" InputGestureText="F1" Click="Help_Click"/>
                            <MenuItem Header="О программе" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" Width="144">
                    <Button x:Name="MinimizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MinimizeBtn_Click" Width="46" Height="32"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0.6,0,0" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Line 3.png" Width="12" Height="12"/>
                    </Button>

                    <Button x:Name="MaximizeBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="MaximizeBtn_Click" Width="46" Height="32"
                            Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Group 2.png" Width="12" Height="12"/>
                    </Button>

                    <Button x:Name="CloseBtn" Background="Transparent" BorderBrush="Transparent"
                            Click="CloseBtn_Click" Width="46" Height="32"
                            Style="{StaticResource CloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom">
                        <Image Source="/Icons/Group 1.png" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="10,0,-10,0" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="187*"/>
                <ColumnDefinition Width="88*"/>
                <ColumnDefinition Width="925*"/>
            </Grid.ColumnDefinitions>

            <!-- Основной Canvas для всех элементов -->
            <Canvas Grid.ColumnSpan="3" x:Name="MainCanvas" Background="#FF252525">

                <!-- Нотация -->
                <Border x:Name="NotationCard"
                        Canvas.Left="42" 
                        Canvas.Top="147"
                        Width="274"
                        Height="225"
                        Background="#343434"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Canvas.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Top">

                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" Color="Black" Opacity="0.3" BlurRadius="10"/>
                    </Border.Effect>

                    <Grid Margin="20,20,-1,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Нотация" 
                          Grid.Row="0"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="White"
                          HorizontalAlignment="Left"
                          Margin="89,-5,0,15">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="-0.028"/>
                                    <TranslateTransform Y="-0.03"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="5">
                            <Canvas x:Name="NotationCanvas" Height="428" Background="Transparent">

                                <Ellipse x:Name="Circle"
                                Width="80"
                                Height="80"
                                Fill="White"
                                Stroke="#343434"
                                StrokeThickness="3"
                                Cursor="Hand" Canvas.Left="10"/>
                                <Ellipse x:Name="SimpleRing"
                                Width="80"
                                Height="80"
                                Stroke="White"
                                StrokeThickness="5"
                                Fill="Transparent"
                                Cursor="Hand" Canvas.Left="131" Canvas.Top="3"/>
                                <!-- Кольцо -->
                                <Ellipse x:Name="Ellipse"
                                Stroke="White"
                                StrokeThickness="2"
                                Fill="Transparent"
                                Cursor="Hand" Height="42" Width="90" HorizontalAlignment="Left" Canvas.Top="106" VerticalAlignment="Center" Canvas.Left="126"/>
                                <Border x:Name="UmlInitialNode" 
                            Width="70" 
                            Height="70"
                            Background="Transparent"
                            BorderBrush="White"
                            BorderThickness="3"
                            CornerRadius="35"
                            Cursor="Hand" Canvas.Left="15" Canvas.Top="92">
                                    <Ellipse Width="60"
                             Height="60"
                             Fill="White"
                             Stroke="Black"
                             StrokeThickness="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="Square"
                                Width="50"
                                Height="50"
                                Background="#343434"
                                BorderBrush="White"
                                BorderThickness="2"
                                CornerRadius="0"
                                Cursor="Hand" Canvas.Left="20" Canvas.Top="294"/>
                                <Border x:Name="Rectangle"
                                Background="#343434"
                                BorderBrush="White"
                                BorderThickness="2"
                                Cursor="Hand" RenderTransformOrigin="0.506,0.529" Height="38" Width="80" Canvas.Left="126" Canvas.Top="300"/>
                                <!-- Овал -->
                                <!-- Квадрат -->

                                <!-- Прямоугольник -->
                                <Border x:Name="SuperEllipse"
                                Background="#343434"
                                BorderBrush="White"
                                BorderThickness="2"
                                CornerRadius="25"
                                Cursor="Hand" RenderTransformOrigin="0.506,0.529" Height="46" Width="89" Canvas.Left="127" Canvas.Top="182" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border x:Name="ResizableSquare"
                                Width="50"
                                Height="51"
                                Background="#343434"
                                BorderBrush="White"
                                BorderThickness="2"
                                CornerRadius="0"
                                Cursor="Hand" RenderTransformOrigin="0.557,0.5" Canvas.Left="25" Canvas.Top="188">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="45.354"/>
                                            <TranslateTransform X="-0.845" Y="2.027"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="stick"
        Background="Black"
        BorderBrush="Black"
        BorderThickness="2"
                                CornerRadius="0.5"
        Cursor="Hand" RenderTransformOrigin="0.506,0.529" Height="4" Width="150" Canvas.Left="38" Canvas.Top="387"/>
                                <!--Прямоугольник со скругленными углами  -->
                                <!-- Ромб -->
                            </Canvas>
                        </ScrollViewer>


                    </Grid>
                </Border>

            </Canvas>

        </Grid>

        <!-- Прямоугольная панель снизу -->
        <Border CornerRadius="11.72" 
                Background="#FF343434" 
                Width="293" 
                Height="52"
                Margin="458,694,453,38"
                Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="">
            <StackPanel Orientation="Horizontal"
                       VerticalAlignment="Center" Width="293" Height="52" HorizontalAlignment="Center">
                <!-- Ручной инструмент -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="16,0,5,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}" HorizontalAlignment="Center">
                    <Image Source="/Icons/Vector.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
                <!-- Перо -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="9,0,11,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                    <Image Source="/Icons/pen.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
                <!-- Квадратик -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="4,0,5,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                    <Image Source="/Icons/Rectangle 20.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
                <!-- Текст -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="12,0,5,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                    <Image Source="/Icons/text.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
                <!-- Комментарий -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="8,0,5,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                    <Image Source="/Icons/message.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
                <!-- Квадратики -->
                <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="9,0,0,0"
                        Background="#FF343434"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                    <Image Source="/Icons/dashboard.png"
                           Width="30" 
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Панели справа -->
        <Border Cursor="Hand" Margin="2,10,-2,-10" Grid.Row="1">
            <Grid Margin="-51,10,51,-10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="617*"/>
                    <RowDefinition Height="143*"/>
                </Grid.RowDefinitions>

                <!-- Панель с размерами -->
                <Border CornerRadius="15" 
                        Background="#FF343434" 
                        Width="240" 
                        Height="84"
                        Margin="0,65,26,540" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="200" Height="61">

                        <TextBlock Text="Размеры" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Ширина -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,15,0">
                                <TextBlock Text="W" 
                                           Foreground="White" 
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Width="20"
                                           TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                        Width="60" 
                                        Height="22"
                                        Background="#D9D9D9"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <TextBox x:Name="WidthTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="11"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             Text=""/>
                                </Border>
                            </StackPanel>

                            <!-- Высота -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="15,0,0,0">
                                <TextBlock Text="H" 
                                           Foreground="White" 
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Width="20"
                                           TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                        Width="60" 
                                        Height="22"
                                        Background="#D9D9D9"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <TextBox x:Name="HeightTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="11"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             Text=""/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Панель с заливкой -->
                <Border CornerRadius="15" 
                        Background="#FF343434" 
                        Width="240" 
                        Height="84"
                        Margin="0,193,26,448" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="200">

                        <TextBlock Text="Заливка" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Превью цвета -->
                            <Border x:Name="FillColorPreview"
                                    CornerRadius="5"
                                    Width="40" 
                                    Height="22"
                                    Background="#FFC44141"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    BorderThickness="1"
                                    BorderBrush="#FF666666"/>

                            <!-- HEX код цвета -->
                            <Border CornerRadius="5"
                                    Width="80" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBox x:Name="FillColorTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="11"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Text="C44141"
                                         CharacterCasing="Upper"/>
                            </Border>

                            <!-- Кнопка выбора цвета -->
                            <Button x:Name="FillColorPickerButton"
                                    Width="22" 
                                    Height="22"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}">
                            </Button>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Панель с обводкой -->
                <Border CornerRadius="15" 
                        Background="#FF343434" 
                        Width="240" 
                        Height="84"
                        Margin="0,308,26,350" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="200">

                        <TextBlock Text="Обводка" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Поле с цветом обводки -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Превью цвета -->
                            <Border x:Name="StrokeColorPreview"
                                    CornerRadius="5"
                                    Width="40" 
                                    Height="22"
                                    Background="#FF000000"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    BorderThickness="1"
                                    BorderBrush="#FF666666"/>

                            <!-- HEX код цвета -->
                            <Border CornerRadius="5"
                                    Width="80" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBox x:Name="StrokeColorTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="11"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Text="000000"
                                         CharacterCasing="Upper"/>
                            </Border>

                            <!-- Кнопка выбора цвета -->
                            <Button x:Name="StrokeColorPickerButton"
                                    Width="22" 
                                    Height="22"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}">
                            </Button>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Панель с текстом -->
                <Border CornerRadius="15" 
                        Background="#FF343434" 
                        Width="240" 
                        Height="120"
                        Margin="0,416,26,215" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="200">

                        <TextBlock Text="Текст" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- Шрифт -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,10">

                            <Border CornerRadius="5"
                                    Width="150" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center">
                                <ComboBox x:Name="FontComboBox"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="11"
                                          VerticalContentAlignment="Center"
                                          Padding="5,0">
                                    <ComboBoxItem Content="Gotham Pro" IsSelected="True"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Calibri"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Стиль и размер -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Стиль -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">

                                <Border CornerRadius="5"
                                        Width="60" 
                                        Height="22"
                                        Background="#D9D9D9"
                                        VerticalAlignment="Center">
                                    <ComboBox x:Name="FontStyleComboBox"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              FontSize="11"
                                              VerticalContentAlignment="Center"
                                              Padding="5,0" Margin="0,0,-8,0">
                                        <ComboBoxItem Content="Regular" IsSelected="True"/>
                                        <ComboBoxItem Content="Bold"/>
                                        <ComboBoxItem Content="Italic"/>
                                        <ComboBoxItem Content="Bold Italic"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <!-- Размер -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0" Width="53">

                                <Border CornerRadius="5"
                                        Width="50" 
                                        Height="22"
                                        Background="#D9D9D9"
                                        VerticalAlignment="Center">
                                    <ComboBox x:Name="FontSizeComboBox"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              FontSize="11"
                                              VerticalContentAlignment="Center"
                                              Padding="5,0">
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10" IsSelected="True"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="18"/>
                                        <ComboBoxItem Content="20"/>
                                        <ComboBoxItem Content="24"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Панель с экспортом -->
                <Border CornerRadius="15" 
                        Background="#FF343434" 
                        Width="240" 
                        Height="120"
                        Margin="940,550,26,90" Grid.RowSpan="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="200">

                        <TextBlock Text="Экспорт" 
                                   Foreground="White" 
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- Формат экспорта -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,15">
                            <Border CornerRadius="5"
                                    Width="150" 
                                    Height="22"
                                    Background="#D9D9D9"
                                    VerticalAlignment="Center">
                                <ComboBox x:Name="ExportFormatComboBox"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="11"
                                          VerticalContentAlignment="Center"
                                          Padding="5,0">
                                    <ComboBoxItem Content="PNG" IsSelected="True"/>
                                    <ComboBoxItem Content="JPG"/>
                                    <ComboBoxItem Content="SVG"/>
                                    <ComboBoxItem Content="PDF"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Кнопка экспорта -->
                        <Button x:Name="ExportButton"
                                Content="Экспорт диаграммы"
                                Width="160" 
                                Height="30"
                                Background="#FF505050"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Window>