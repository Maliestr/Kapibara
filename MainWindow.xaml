<Window x:Class="Graphic_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphic_Editor"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        MaxHeight="800"
        MaxWidth="1200"
        MinHeight="800"
        MinWidth="1200"
        Padding="6"
        Background="#FF252525"
        FontFamily="Gotham Pro">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="187*"/>
            <ColumnDefinition Width="13*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Title bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#424242" Grid.ColumnSpan="2">
            <!--можно добавить MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" для обработки событий связанных с левой кнопкой мыши-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="/Icons/L.png"
                       Width="25.82" Height="25.82" 
                       Margin="15,11,15,3"/>

                <Menu Background="Transparent" 
                      FontSize="12" 
                      Grid.Column="1" VerticalAlignment="Top" 
                      Foreground="#FFEEEEEE" Grid.ColumnSpan="4" Margin="0,16,0,0">
                    <!-- Пункт "Файл" -->
                    <MenuItem Header="Файл" VerticalAlignment="Center" Margin="0,0,18,0">
                        <MenuItem Header="Новый"/>
                        <MenuItem Header="Открыть..."/>
                        <MenuItem Header="Сохранить"/>
                        <MenuItem Header="Сохранить как..."/>
                        <Separator/>
                        <MenuItem Header="Выход"/>
                    </MenuItem>

                    <!-- Пункт "Вид" -->
                    <MenuItem Header="Вид" Margin="0,0,18,0">
                        <MenuItem Header="Увеличить"/>
                        <MenuItem Header="Уменьшить"/>
                        <MenuItem Header="Сбросить масштаб"/>
                    </MenuItem>

                    <!-- Дополнительные пункты -->
                    <MenuItem Header="Правка" Margin="0,0,18,0">
                        <MenuItem Header="Отменить" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="Повторить" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Вырезать" InputGestureText="Ctrl+X"/>
                        <MenuItem Header="Копировать" InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Вставить" InputGestureText="Ctrl+V"/>
                    </MenuItem>

                    <MenuItem Header="Справка">
                        <MenuItem Header="Справка" InputGestureText="F1"/>
                        <MenuItem Header="О программе"/>
                    </MenuItem>
                </Menu>

                <StackPanel/>

                <!--<Style x:Key="CloseButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#e81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>-->

                <!--<Style x:Key="CloseBtn" TargetType="Button">
                    
                </Style>-->

                <!--<StackPanel Grid.Column="7" Orientation="Horizontal">
                
                    <Button x:Name="MinimizeBtn" Background="Transparent" BorderBrush="#00000000">
                        <Image Source="/Icons/Line 3.png" Width="12" Height="12" Margin="16,8,16,0"/>
                    </Button>

                    <Button x:Name="MaximizeBtn" Background="Transparent" BorderBrush="#00000000">
                        <Image Source="/Icons/Group 2.png" Width="12" Height="12" Margin="16,8,16,0"/>
                    </Button>

                    <Button x:Name="CloseBtn" Background="Transparent" BorderBrush="#00000000">
                        <Image Source="/Icons/Group 1.png" Width="12" Height="12" Margin="16,8,24,0"/>
                    </Button>
                </StackPanel> -->
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2">
            <!--мои изменения тут -->
            <Grid>
                <!-- Прямоугольная панель снизу -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="293" 
                Height="52"
                Margin="454,694,453,14"
                Grid.Row="1">
                    <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                        <!-- Ручной инструмент -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF3939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Vector.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Перо -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF393939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/pen.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратик -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF393939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/Rectangle 20.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Текст -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF393939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/text.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Комментарий -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF393939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/message.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Квадратики -->
                        <Button      
                        Width="32" 
                        Height="32"
                        Cursor="Hand"
                        Margin="5,0"
                        Background="#FF393939"
                        BorderBrush="Transparent"
                        FocusVisualStyle="{x:Null}">
                            <Image Source="/Icons/dashboard.png"
                                    Width="30" 
                                    Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="617*"/>
                    <RowDefinition Height="143*"/>
                </Grid.RowDefinitions>

                <!-- Прямоугольная панель справа 1 -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="84"
                Margin="939,15,21,518">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="84">

                        <!-- Первый белый прямоугольник -->
                        <Border CornerRadius="3"
                        Width="80" 
                        Height="24"
                        Background="#D9D9D9"
                        Margin="10,0,5,0"
                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!-- Текст слева -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/text-align-left.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                                <!-- Текст в центре -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/text-align-center.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                                <!-- Текст справа -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/text-align-right.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Второй белый прямоугольник -->
                        <Border CornerRadius="3"
                        Width="80" 
                        Height="24"
                        Background="#D9D9D9"
                        Margin="5,0,10,0"
                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!-- Сверху -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/align-horizontal-top.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                                <!-- В центре -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/align-horizontal-top.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                                <!-- Снизу -->
                                <Button      
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Margin="2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                                    <Image Source="/Icons/align-horizontal-bottom.png"
                                   Width="16" 
                                   Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Панель с размерами -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="84"
                Margin="939,116,21,417">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200" Height="61">

                        <TextBlock Text="Размеры" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Ширина -->
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">
                                <TextBlock Text="W" 
                                   Foreground="White" 
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Width="20"
                                   TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                Width="60" 
                                Height="22"
                                Background="#D9D9D9"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0">
                                    <TextBox x:Name="WidthTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Text=""/>
                                </Border>
                            </StackPanel>

                            <!-- Высота -->
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                                <TextBlock Text="H" 
                                   Foreground="White" 
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Width="20"
                                   TextAlignment="Center"/>
                                <Border CornerRadius="5"
                                Width="60" 
                                Height="22"
                                Background="#D9D9D9"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0">
                                    <TextBox x:Name="HeightTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Text=""/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>
                <!-- Панель с заливкой -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="84"
                Margin="939,216,21,317">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Заливка" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Превью цвета -->
                            <Border x:Name="FillColorPreview"
                            CornerRadius="5"
                            Width="40" 
                            Height="22"
                            Background="#FFC44141"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            BorderThickness="1"
                            BorderBrush="#FF666666"/>

                            <!-- HEX код цвета -->
                            <Border CornerRadius="5"
                            Width="80" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                                <TextBox x:Name="FillColorTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Text="C44141"
                                 CharacterCasing="Upper"/>
                            </Border>

                            <!-- Кнопка выбора цвета -->
                            <Button x:Name="FillColorPickerButton"
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                            </Button>

                        </StackPanel>

                    </StackPanel>
                </Border>
                <!-- Панель с обводкой -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="84"
                Margin="940,315,20,218">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Обводка" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                        <!-- Поле с цветом обводки -->
                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Превью цвета -->
                            <Border x:Name="StrokeColorPreview"
                            CornerRadius="5"
                            Width="40" 
                            Height="22"
                            Background="#FF000000"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            BorderThickness="1"
                            BorderBrush="#FF666666"/>

                            <!-- HEX код цвета -->
                            <Border CornerRadius="5"
                            Width="80" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                                <TextBox x:Name="StrokeColorTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Text="000000"
                                 CharacterCasing="Upper"/>
                            </Border>

                            <!-- Кнопка выбора цвета -->
                            <Button x:Name="StrokeColorPickerButton"
                            Width="22" 
                            Height="22"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}">
                            </Button>

                        </StackPanel>

                    </StackPanel>
                </Border>
                <!-- Панель с текстом -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="120"
                Margin="940,414,20,83">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Текст" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                        <!-- Шрифт -->
                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10">

                            <Border CornerRadius="5"
                            Width="150" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center">
                                <ComboBox x:Name="FontComboBox"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  Padding="5,0">
                                    <ComboBoxItem Content="Gotham Pro" IsSelected="True"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Calibri"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Стиль и размер -->
                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <!-- Стиль -->
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                                <Border CornerRadius="5"
                                Width="60" 
                                Height="22"
                                Background="#D9D9D9"
                                VerticalAlignment="Center">
                                    <ComboBox x:Name="FontStyleComboBox"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      Padding="5,0" Margin="0,0,-8,0">
                                        <ComboBoxItem Content="Regular" IsSelected="True"/>
                                        <ComboBoxItem Content="Bold"/>
                                        <ComboBoxItem Content="Italic"/>
                                        <ComboBoxItem Content="Bold Italic"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <!-- Размер -->
                            <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" Width="53">

                                <Border CornerRadius="5"
                                Width="50" 
                                Height="22"
                                Background="#D9D9D9"
                                VerticalAlignment="Center">
                                    <ComboBox x:Name="FontSizeComboBox"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      Padding="5,0">
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10" IsSelected="True"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="18"/>
                                        <ComboBoxItem Content="20"/>
                                        <ComboBoxItem Content="24"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>
                <!-- Панель с экспортом -->
                <Border CornerRadius="15" 
                Background="#FF343434" 
                Width="240" 
                Height="120"
                Margin="940,550,20,90" Grid.RowSpan="2">
                    <StackPanel Orientation="Vertical" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">

                        <TextBlock Text="Экспорт" 
                           Foreground="White" 
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                        <!-- Формат экспорта -->
                        <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,15">
                            <Border CornerRadius="5"
                            Width="150" 
                            Height="22"
                            Background="#D9D9D9"
                            VerticalAlignment="Center">
                                <ComboBox x:Name="ExportFormatComboBox"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="11"
                                  VerticalContentAlignment="Center"
                                  Padding="5,0">
                                    <ComboBoxItem Content="PNG" IsSelected="True"/>
                                    <ComboBoxItem Content="JPG"/>
                                    <ComboBoxItem Content="SVG"/>
                                    <ComboBoxItem Content="PDF"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Кнопка экспорта -->
                        <Button x:Name="ExportButton"
                        Content="Экспорт диаграммы"
                        Width="160" 
                        Height="30"
                        Background="#FF505050"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <Button x:Name="escButton" Background="Transparent" BorderBrush="Transparent" 
                IsCancel="True" Click="escButton_Click" Grid.Column="1"
                Margin="22,8,0,8">
            <Image Source="/Icons/Group 1.png" Width="12" Height="12"/>
        </Button>
    </Grid>
</Window>